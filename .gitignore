# ==========================================
# IntentOS — .gitignore
# ==========================================

# --- Secrets & Credentials ---
.env
credentials.json
*.pem
*.key
*.p12

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- Node.js ---
node_modules/
dashboard/frontend/node_modules/
dashboard/frontend/dist/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Generated / Runtime data ---
logs/
screenshots/
sandbox-workspace/
memory/rag/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Misc ---
*.log