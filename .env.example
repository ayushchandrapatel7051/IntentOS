# ==========================================
# IntentOS — Environment Configuration
# ==========================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit .env to version control

# ── Google Cloud / Vertex AI (Required) ───
# Used for Gemini 2.5 Flash planning
# Authenticate with:  gcloud auth application-default login
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# OR provide a service account key file path:
# GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# ── Sarvam AI — Voice Input (Optional) ───
# Get key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_MODEL=saaras:v3
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text

# ── Dashboard Server ──────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_FRONTEND_PORT=3000

# ── Storage Paths ─────────────────────────
SOUL_MD_PATH=./SOUL.md
MEMORY_STORE_PATH=./memory/workflows
SCREENSHOTS_PATH=./screenshots

# ── Logging ───────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/intentos.log

# ── Safety & Limits ───────────────────────
CONFIRM_DELETIONS=true
CONFIRM_GIT_PUSH=true
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.0
