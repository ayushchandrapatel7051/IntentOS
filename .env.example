# ==========================================
# IntentOS Environment Configuration
# ==========================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# --- AI / LLM (planning only) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-haiku-4-5           # Use Haiku for cheapest planning

# --- Sarvam AI (Voice Input) ---
SARVAM_API_KEY=sk_qays6a9k_LxiFnMeZrHpLr54LQiOeq0QG
SARVAM_STT_MODEL=saaras:v3
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_FRONTEND_PORT=3000

# --- Paths ---
SOUL_MD_PATH=./SOUL.md
MEMORY_STORE_PATH=./memory/workflows
SCREENSHOTS_PATH=./screenshots

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/openclaw.log

# --- Security ---
CONFIRM_DELETIONS=true
CONFIRM_GIT_PUSH=true
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.0

# ==========================================
# REMOVED (cost reduction):
#   GOOGLE_CALENDAR_CREDENTIALS  — use browser to access calendar.google.com
#   GOOGLE_CALENDAR_TOKEN        — no OAuth flow needed
#   TELEGRAM_API_ID              — messaging via desktop app shortcuts
#   TELEGRAM_API_HASH
#   TELEGRAM_BOT_TOKEN
#   TELEGRAM_CHAT_ID
#   WHATSAPP_SERVICE_PORT        — WhatsApp via desktop app shortcuts
#   CLAUDE_VISION_MODEL          — vision analysis disabled to save costs
#   DOCKER_SANDBOX_ENABLED       — sandbox not needed now
# ==========================================
