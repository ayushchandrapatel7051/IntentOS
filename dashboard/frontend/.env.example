# IntentOS Frontend — Environment Variables
# Copy to .env and fill in values

# Backend API base URL (default: http://localhost:8000)
VITE_API_BASE=http://localhost:8000

# WebSocket URL (default: ws://localhost:8000/ws)
VITE_WS_URL=ws://localhost:8000/ws

# Optional: Sarvam AI STT endpoint
# Set this when you expose the voice route from your backend
# e.g. VITE_SARVAM_ENDPOINT=http://localhost:8000/api/voice/transcribe
# VITE_SARVAM_ENDPOINT=

# Optional: Sarvam API key (only needed if calling Sarvam directly from frontend)
# VITE_SARVAM_API_KEY=
